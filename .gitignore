.DS_Store
Thumbs.db

# Project working artifacts never belong here — they live in ~/code/docs (local-private repo).
# Junctioned dirs under workspace/docs/ hold reference docs only.
workspace/docs/**/checklists/
workspace/docs/**/continuation/
workspace/docs/**/issues/
workspace/docs/**/screenshots/
workspace/docs/**/specs/
workspace/docs/**/assets/

# Runtime-staged agent types — reflect promotes (rename into agents/) or deletes them.
agents/staged-*

# In-session subagent worktrees (Agent isolation: "worktree").
.claude/worktrees/

# Python bytecode from skill scripts.
__pycache__/
*.pyc
